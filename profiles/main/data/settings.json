			"folderNames": [
				"ffmpeg"
			]
		},
		{
			"name": "factory",
			"base": "store",
			"color": "red-500",
			"lightColor": "red-700",
			"folderNames": [
				"factory",
				"factories"
			]
		},
		{
			"name": "components",
			"base": "components",
			"color": "orange-700",
			"lightColor": "orange-700",
			"folderNames": [
				"components"
			]
		},
		{
			"name": "ui",
			"base": "custom",
			"color": "#222",
			"lightColor": "#08080a",
			"folderNames": [
				"ui"
			]
		},
		{
			"name": "features",
			"base": "supabase",
			"color": "#09c",
			"lightColor": "#09c",
			"folderNames": [
				"features"
			]
		},
		{
			"name": "const",
			"base": "constant",
			"color": "gray-800",
			"lightColor": "gray-900",
			"folderNames": [
				"const",
				"consts"
			]
		},
		{
			"name": "http",
			"base": "public",
			"color": "#fd3434",
			"lightColor": "#fd3434",
			"folderNames": [
				"http"
			]
		},
		{
			"name": "nocobase",
			"base": "unity",
			"color": "#333",
			"lightColor": "#444",
			"folderNames": [
				"nocobase"
			]
		}
	],
	"material-icon-theme.files.customClones": [
		{
			"base": "vitest",
			"color": "blue-400",
			"fileNames": [
				".coveragebadgesrc"
			]
		}
	],
	//|
	//| === Better Comments ===
	//|
	"better-comments.tags": [
		// !
		{
			"tag": "!",
			"color": "#ff8a82",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// ?
		{
			"tag": "?",
			"color": "#89caff",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// |
		{
			"tag": "|",
			"color": "#f0c050",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// [
		{
			"tag": "[",
			"color": "#ffb067",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// -
		{
			"tag": "-",
			"color": "#ddb5ff",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// *
		{
			"tag": "*",
			"color": "#8ef090",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// ~
		{
			"tag": "~",
			"color": "#b080ff",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// TODO
		{
			"tag": "TODO",
			"color": "#ffdd55",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// FIXME
		{
			"tag": "FIXME",
			"color": "#ff6b6b",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// HACK
		{
			"tag": "HACK",
			"color": "#ff9f43",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// NOTE
		{
			"tag": "NOTE",
			"color": "#54a0ff",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// @
		{
			"tag": "@",
			"color": "#00d2d3",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// #
		{
			"tag": "#",
			"color": "#ff78c4",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// >
		{
			"tag": ">",
			"color": "#1dd1a1",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// $
		{
			"tag": "$",
			"color": "#feca57",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// ^
		{
			"tag": "^",
			"color": "#00d2d3",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// bundle-only:
		{
			"tag": "bundle-only:",
			"color": "#e2a932",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		},
		// no-bundle:
		{
			"tag": "no-bundle",
			"color": "#ff6159",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false
		}
	],
	"diffEditor.maxComputationTime": 0,
	"claudeCode.preferredLocation": "panel",
	"github.copilot.chat.agentDebugLog.fileLogging.enabled": true,
	"editor.unicodeHighlight.invisibleCharacters": false,
	"workbench.editor.useModal": "some",
	"diffEditor.hideUnchangedRegions.enabled": true,
	"explorer.fileNesting.patterns": {
		"*.ts": "${capture}.js",
		"*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
		"*.jsx": "${capture}.js",
		"*.tsx": "${capture}.ts",
		"tsconfig.json": "tsconfig.*.json",
		"package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
		"*.sqlite": "${capture}.${extname}-*",
		"*.db": "${capture}.${extname}-*",
		"*.sqlite3": "${capture}.${extname}-*",
		"*.db3": "${capture}.${extname}-*",
		"*.sdb": "${capture}.${extname}-*",
		"*.s3db": "${capture}.${extname}-*"
	},
	"chat.viewSessions.orientation": "stacked",
	//^ === New Configs === ^
