{
	//*
	//* === Settings Sync ===
	//*
	//|
	//| === Ignored Settings ===
	//|
	"settingsSync.ignoredSettings": [
		"terminal.integrated.defaultProfile.windows",
		"terminal.integrated.defaultProfile.linux",
		"terminal.integrated.profiles.windows",
		"terminal.integrated.profiles.linux",
		"window.newWindowProfile",
		"biome.lsp.bin"
	],
	//|
	//| === Ignored Extensions ===
	//|
	"settingsSync.ignoredExtensions": [],
	//|
	//| Settings Repository
	//|
	"syncSettings.confirmSync": true,
	"syncSettings.openOutputOnActivity": true,
	"syncSettings.resources": [
		"extensions",
		"keybindings",
		"settings",
		"snippets",
		"tasks"
	],
	"syncSettings.additionalFiles": [
		"~/.copilot"
	],
	"syncSettings.ignoredSettings": [
		"terminal.integrated.defaultProfile.windows",
		"terminal.integrated.defaultProfile.linux",
		"terminal.integrated.profiles.windows",
		"terminal.integrated.profiles.linux",
		"window.newWindowProfile",
		"biome.lsp.bin"
	],
	"workbench.colorTheme": "GitHub Dark Mode",
	"workbench.iconTheme": "material-icon-theme",
	"workbench.layoutControl.enabled": false,
	"workbench.editor.empty.hint": "hidden",
	"workbench.activityBar.compact": true,
	"workbench.startupEditor": "none",
	"task.allowAutomaticTasks": "on",
	//|
	//| === Window ===
	//|
	"window.menuBarVisibility": "compact",
	"window.commandCenter": false,
	//|
	//| === Terminal ===
	//|
	//"terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
	"terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
	"terminal.integrated.shellIntegration.enabled": true,
	"terminal.integrated.cursorBlinking": true,
	"terminal.integrated.cursorStyle": "block",
	"terminal.integrated.fontLigatures.enabled": true,
	//|
	//| === Editor ===
	//| Download font at https://www.jetbrains.com/lp/mono/
	//|
	"editor.fontFamily": "'JetBrains Mono', monospace",
	"editor.fontSize": 14,
	"editor.wordWrap": "on",
	"editor.formatOnSave": true,
	"editor.linkedEditing": true,
	"editor.fontLigatures": true,
	"editor.minimap.size": "fill",
	"editor.minimap.side": "right",
	"editor.minimap.enabled": true,
	"editor.minimap.showSlider": "always",
	"editor.minimap.renderCharacters": false,
	"editor.bracketPairColorization.enabled": true,
	"editor.multiCursorModifier": "ctrlCmd",
	//|
	//| === onSave Actions ===
	//|
	"editor.codeActionsOnSave": {
		"source.fixAll": "never",
		"source.biome": "explicit",
		"source.fixAll.biome": "explicit",
		"source.organizeImports.biome": "explicit"
		// "source.sortImports": "explicit",
		// "source.removeUnused.ts": "never",
		// "source.organizeImports": "explicit",
		// "source.addMissingImports.ts": "explicit",
	},
	//|
	//| === Importing Config ===
	//|
	"js/ts.updateImportsOnFileMove.enabled": "always",
	"js/ts.preferences.autoImportFileExcludePatterns": [
		"@radix-ui",
		"/@radix-ui",
		"*/@radix-ui",
		"*/@radix-ui/*",
		"*@radix-ui/*",
		"/@radix-ui*",
		"@base-ui*",
		"@base-ui/*",
		"@base-ui/react"
	],
	//|
	//| === Files ===
	//|
	"files.trimTrailingWhitespace": true,
	"files.insertFinalNewline": true,
	"files.associations": {
		"*.embeddedhtml": "html",
		"*.vars": "properties",
		".env*": "dotenv",
		"sdkconfig*": "makefile",
		"*.cpp": "cpp",
		"*.mdx": "markdown",
		"SKILL.md": "markdown"
	},
	"files.watcherExclude": {
		"**/.git/objects/**": true,
		"**/node_modules/**": true,
		"**/build/**": true
	},
	//|
	//| === File Formatters ===
	//|
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[html]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[php]": {
		"editor.defaultFormatter": "vscode.php-language-features"
	},
	"[markdown]": {
		"editor.defaultFormatter": "yzhang.markdown-all-in-one"
	},
	"[css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	//|
	//| === Cspell ===
	//|
	"cSpell.language": "pt-BR, en",
	"cSpell.caseSensitive": false,
	"cSpell.languageSettings": [
		{
			"languageId": "typescript",
			"caseSensitive": false
		},
		{
			"languageId": "typescriptreact",
			"caseSensitive": false
		},
		{
			"languageId": "javascript",
			"caseSensitive": false
		},
		{
			"languageId": "javascriptreact",
			"caseSensitive": false
		}
	],
	"cSpell.userWords": [
		"Carbonera",
		"gugacarbo",
		"Legnaghi"
	],
	//|
	//| === Markdown ===
	//|
	"markdown-preview-enhanced.enablePreviewZenMode": true,
	"markdown-preview-enhanced.previewTheme": "github-dark.css",
	"markdown-preview-enhanced.codeBlockTheme": "auto.css",
	//|
	//| === Dotenv ===
	//|
	"dotenv.enableAutocloaking": false,
	"dotenv.cloakColor": "oklch(70.4% 0.191 22.216)",
	"dotenv.cloakIcon": "∎",
	// "dotenv.cloakIcon": "•",
	"editor.tokenColorCustomizations": {
		"textMateRules": []
	},
	//|
	//| === Markdown ===
	//|
	"markdown-preview-enhanced.revealjsTheme": "black.css",
	"markdown-preview-enhanced.chromePath": "/usr/bin/google-chrome",
	"makefile.configureOnOpen": true,
	//*
	//* === AI ===
	//*
	//|
	//| === MCP ===
	//|
	"chat.mcp.gallery.enabled": true,
	"chat.mcp.serverSampling": {},
	"chat.tools.urls.autoApprove": {
		"https://code.visualstudio.com": true,
		"https://github.com/microsoft/vscode/wiki/*": true,
		"https://zod.dev": true,
		"https://github.com": true,
		"https://*.platformio.org": true
	},
	//|
	//| === Chat ===
	//|
	"chat.fontFamily": "JetBrains Mono",
	"chat.editor.fontFamily": "JetBrains Mono",
	"chat.agent.maxRequests": 100,
	"chat.agent.codeBlockProgress": true,
	"chat.agent.thinkingStyle": "collapsedPreview",
	"chat.requestQueuing.defaultAction": "queue",
	"chat.checkpoints.showFileChanges": true,
	"chatgpt.followUpQueueMode": "queue",
	"chat.tools.terminal.autoApprove": {
		"npx markdownlint-cli2": true
	},
	"chat.mcp.autostart": "newAndOutdated",
	//|
	//| === GitHub Copilot ===
	//|
	"github.copilot.chat.agent.autoFix": true,
	"github.copilot.chat.localeOverride": "pt-br",
	"github.copilot.chat.organizationCustomAgents.enabled": false,
	"github.copilot.chat.languageContext.fix.typescript.enabled": true,
	"github.copilot.chat.languageContext.typescript.enabled": true,
	"github.copilot.chat.languageContext.inline.typescript.enabled": true,
	"github.copilot.enable": {
		"*": true,
		"plaintext": true,
		"markdown": true,
		"scminput": true
	},
	"github.copilot.chat.anthropic.tools.websearch.userLocation": {
		"city": "Lages",
		"region": "Santa Catarina",
		"country": "Brazil",
		"timezone": "America/Sao_Paulo"
	},
	"chat.agentFilesLocations": {
		".agents/agents": true
	},
	"chat.instructionsFilesLocations": {
		".agents/rules": true
	},
	"json.schemaDownload.trustedDomains": {
		"https://biomejs.dev": true,
		"https://developer.microsoft.com/json-schemas/": true,
		"https://json-schema.org/": true,
		"https://json.schemastore.org/": true,
		"https://mintlify.com": true,
		"https://models.dev": true,
		"https://opencode.ai": true,
		"https://raw.githubusercontent.com": true,
		"https://raw.githubusercontent.com/devcontainers/spec/": true,
		"https://raw.githubusercontent.com/microsoft/vscode/": true,
		"https://schemastore.azurewebsites.net/": true,
		"https://turbo.build": true,
		"https://ui.shadcn.com": true,
		"https://unpkg.com": true,
		"https://www.schemastore.org/": true
	},
	//*
	//* === Customizations ===
	//*
	//|
	//| === Material Icon Theme ===
	//|
	"material-icon-theme.folders.customClones": [
