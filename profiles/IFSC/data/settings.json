{
	//*
	//* === Settings Sync ===
	//*
	//|
	//| === Ignored Settings ===
	//|
	"settingsSync.ignoredSettings": [
		"terminal.integrated.profiles.windows",
		"terminal.integrated.profiles.linux",
		"terminal.integrated.defaultProfile.windows",
		"terminal.integrated.defaultProfile.linux",
		"window.newWindowProfile",
		"biome.lsp.bin"
	],
	//|
	//| === Ignored Extensions ===
	//|
	"settingsSync.ignoredExtensions": [	],
	//|
	//| Settings Repository
	//|
	"syncSettings.confirmSync": true,
	"syncSettings.openOutputOnActivity": true,
	"syncSettings.hostname": "{{hostname}}",
	"syncSettings.gitInitMessage": "Profile ({{profile}}): init at {{now|date:iso}}",
	"syncSettings.gitUpdateMessage": "Profile ({{profile}}): update at {{now|date:iso}}",
	"syncSettings.resources": [
		"extensions",
		"keybindings",
		"settings",
		"snippets",
		"tasks",
	],
	"syncSettings.additionalFiles": [
		"~/.copilot",
		"~/.claude",
	],
	"syncSettings.hooks.preUpload": [],
	//|
	//| === Window ===
	//|
	"window.commandCenter": false,
	"window.menuBarVisibility": "compact",
	"accessibility.verbosity.terminal": false,
	"task.allowAutomaticTasks": "on",
	//|
	//| === Workbench ===
	//|
	"workbench.colorTheme": "GitHub Dark Mode",
	"workbench.iconTheme": "material-icon-theme",
	"workbench.startupEditor": "none",
	"workbench.layoutControl.enabled": false,
	"workbench.editor.empty.hint": "hidden",
	"workbench.activityBar.compact": true,
	//|
	//| === Terminal ===
	//|
	"terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
	"terminal.integrated.shellIntegration.enabled": true,
	"terminal.integrated.cursorBlinking": true,
	"terminal.integrated.cursorStyle": "block",
	"terminal.integrated.fontLigatures.enabled": true,
	//|
	//| === Editor ===
	//| Download font at https://www.jetbrains.com/lp/mono/
	//|
	"editor.fontFamily": "JetBrains Mono",
	"editor.fontSize": 14,
	"editor.wordWrap": "on",
	"editor.formatOnSave": true,
	"editor.linkedEditing": true,
	"editor.fontLigatures": true,
	"editor.minimap.size": "fill",
	"editor.minimap.side": "right",
	"editor.minimap.enabled": true,
	"editor.minimap.showSlider": "always",
	"editor.minimap.renderCharacters": false,
	"editor.bracketPairColorization.enabled": true,
	//|
	//| === onSave Actions ===
	//|
	"editor.codeActionsOnSave": {
		"source.fixAll": "never",
		"source.biome": "explicit",
		"source.organizeImports.biome": "explicit",
		// "source.sortImports": "explicit",
		// "source.fixAll.biome": "explicit",
		// "source.removeUnused.ts": "never",
		// "source.organizeImports": "explicit",
		// "source.addMissingImports.ts": "explicit",
	},
	//|
	//| === Importing Config ===
	//|
	"js/ts.updateImportsOnFileMove.enabled": "always",
	"js/ts.preferences.autoImportFileExcludePatterns": [
		"@radix-ui",
		"/@radix-ui",
		"*/@radix-ui",
		"*/@radix-ui/*",
		"*@radix-ui/*",
		"/@radix-ui*",
	],
	//*
	//* ** Files ***
	//*
	"files.trimTrailingWhitespace": true,
	"files.insertFinalNewline": true,
	"files.associations": {
		"*.embeddedhtml": "html",
		"*.vars": "properties",
		".env*": "dotenv"
	},
	"files.watcherExclude": {
		"**/.git/objects/**": true,
		"**/node_modules/**": true,
		"**/build/**": true,
	},
	//|
	//| === File Formatters ===
	//|
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome",
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome",
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome",
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "biomejs.biome",
	},
	"[html]": {
		"editor.defaultFormatter": "biomejs.biome",
	},
	"[php]": {
		"editor.defaultFormatter": "vscode.php-language-features",
	},
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features",
	},
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features",
	},
	"[markdown]": {
		"editor.defaultFormatter": "yzhang.markdown-all-in-one",
	},
	//|
	//| === Cspell ===
	//|
	"cSpell.language": "PT-br, en",
	"cSpell.userWords": [
		"Carbonera",
		"gugacarbo",
		"Legnaghi"
	],
	//|
	//| === Markdown ===
	//|
	"markdown-preview-enhanced.enablePreviewZenMode": true,
	"markdown-preview-enhanced.previewTheme": "github-dark.css",
	"markdown-preview-enhanced.codeBlockTheme": "github-dark.css",
	//|
	//| === Dotenv ===
	//|
	"dotenv.enableAutocloaking": false,
	"dotenv.cloakColor": "oklch(70.4% 0.191 22.216)",
	"dotenv.cloakIcon": "∎",
	// "dotenv.cloakIcon": "•",
	"editor.tokenColorCustomizations": {
		"textMateRules": []
	},
	"markdown-preview-enhanced.revealjsTheme": "black.css",
	//*
	//* === AI ===
	//*
	//|
	//| === Chat ===
	//|
	"chat.fontFamily": "JetBrains Mono",
	"chat.editor.fontFamily": "JetBrains Mono",
	"chat.agent.maxRequests": 100,
	"chat.agent.codeBlockProgress": true,
	"chat.agent.thinkingStyle": "collapsedPreview",
	"chat.viewSessions.orientation": "stacked",
	"chat.requestQueuing.defaultAction": "queue",
	"chat.checkpoints.showFileChanges": true,
	//|
	//| === MCP ===
	//|
	"chat.mcp.gallery.enabled": true,
	"chat.tools.urls.autoApprove": {
		"https://zod.dev": true,
		"https://github.com": true
	},
	//|
	//| === GitHub Copilot ===
	//|
	"github.copilot.chat.agent.autoFix": true,
	"github.copilot.chat.localeOverride": "pt-br",
	"github.copilot.chat.organizationCustomAgents.enabled": false,
	"github.copilot.chat.languageContext.fix.typescript.enabled": true,
	"github.copilot.chat.languageContext.typescript.enabled": true,
	"github.copilot.chat.languageContext.inline.typescript.enabled": true,
	"github.copilot.enable": {
		"*": true,
		"plaintext": true,
		"markdown": true,
		"scminput": true
	},
	"github.copilot.chat.anthropic.tools.websearch.userLocation": {
		"city": "Lages",
		"region": "Santa Catarina",
		"country": "Brazil",
		"timezone": "America/Sao_Paulo",
	},
	//*
	//* === Customizations ===
	//*
	//|
	//| === Material Icon Theme ===
	//|
	"material-icon-theme.folders.customClones": [
		{
			"name": "ini",
			"base": "config",
			"color": "light-blue-500",
			"lightColor": "blue-800",
			"folderNames": [
				"ini"
			],
		},
		{
			"name": "ffmpeg",
			"base": "video",
			"color": "green-700",
			"lightColor": "green-800",
			"folderNames": [
				"ffmpeg"
			],
		},
		{
			"name": "factory",
			"base": "store",
			"color": "red-500",
			"lightColor": "red-700",
			"folderNames": [
				"factory",
				"factories"
			],
		},
		{
			"name": "components",
			"base": "components",
			"color": "orange-700",
			"lightColor": "orange-700",
			"folderNames": [
				"components"
			],
		},
		{
			"name": "ui",
			"base": "custom",
			"color": "#222",
			"lightColor": "#08080a",
			"folderNames": [
				"ui"
			],
		},
		{
			"name": "features",
			"base": "supabase",
			"color": "#09c",
			"lightColor": "#09c",
			"folderNames": [
				"features"
			],
		},
		{
			"name": "const",
			"base": "constant",
			"color": "gray-800",
			"lightColor": "gray-900",
			"folderNames": [
				"const",
				"consts"
			],
		},
		{
			"name": "http",
			"base": "public",
			"color": "#fd3434",
			"lightColor": "#fd3434",
			"folderNames": [
				"http"
			],
		},
		{
			"name": "nocobase",
			"base": "unity",
			"color": "#333",
			"lightColor": "#444",
			"folderNames": [
				"nocobase"
			],
		},
	],
	"material-icon-theme.files.customClones": [
		{
			"base": "vitest",
			"color": "blue-400",
			"fileNames": [
				".coveragebadgesrc"
			],
		}
	],
	//|
	//| === Better Comments ===
	//|
	"better-comments.tags": [
		// !
		{
			"tag": "!",
			"color": "#ff8a82",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		// ?
		{
			"tag": "?",
			"color": "#89caff",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		// |
		{
			"tag": "|",
			"color": "#f0c050",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		// [
		{
			"tag": "[",
			"color": "#ffb067",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		// -
		{
			"tag": "-",
			"color": "#ddb5ff",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		// *
		{
			"tag": "*",
			"color": "#8ef090",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		// ~
		{
			"tag": "~",
			"color": "#b080ff",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		// TODO
		{
			"tag": "TODO",
			"color": "#ffdd55",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		// FIXME
		{
			"tag": "FIXME",
			"color": "#ff6b6b",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		// HACK
		{
			"tag": "HACK",
			"color": "#ff9f43",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		// NOTE
		{
			"tag": "NOTE",
			"color": "#54a0ff",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		// @
		{
			"tag": "@",
			"color": "#00d2d3",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		// #
		{
			"tag": "#",
			"color": "#ff78c4",
			"strikethrough": false,
			"underline": false,
